#include <stdint.h>
#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"
#include "mult_16_bit.h"
#include "sc_fifo_axi.h"

#define MULT_BASE_ADDR (0x43C00000)

#define A_REG_ADDR      (MULT_BASE_ADDR + MULT_16_OP_1_REG_OFFSET)
#define B_REG_ADDR      (MULT_BASE_ADDR + MULT_16_OP_2_REG_OFFSET)
#define P_REG_ADDR      (MULT_BASE_ADDR + MULT_16_P_REG_OFFSET)

int main()
{
    init_platform();

    xil_printf("Start of Multiplier Test\n");

    Xil_Out32(A_REG_ADDR, 8);
    Xil_Out32(B_REG_ADDR, 8);

    uint32_t a_val = Xil_In32(A_REG_ADDR);
    uint32_t b_val = Xil_In32(B_REG_ADDR);
    uint32_t p_val = Xil_In32(P_REG_ADDR);

    xil_printf("A: %d\n", a_val);
    xil_printf("B: %d\n", b_val);
    xil_printf("P: %d\n", p_val);

    xil_printf("End of Multiplier Test\n");

    cleanup_platform();
    return 0;
}
